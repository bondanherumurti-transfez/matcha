# ---- Langfuse (tracing, self-hosted) -----------------------------------------
# Start the whole stack with: docker compose up -d (UI: http://localhost:3001)
# Self-hosted Langfuse project keys below must match LANGFUSE_INIT_PROJECT_* farther down.
LANGFUSE_TRACING=true
LANGFUSE_PUBLIC_KEY=pk-lf-...
LANGFUSE_SECRET_KEY=sk-lf-...
LANGFUSE_BASE_URL=http://localhost:3001
# LANGFUSE_TRACING_ENVIRONMENT=local
LANGFUSE_IMAGE_TAG=4
LANGFUSE_WEB_PORT=3001
NEXTAUTH_URL=http://localhost:3001
NEXTAUTH_SECRET=            # openssl rand -hex 32
SALT=                       # openssl rand -hex 16
ENCRYPTION_KEY=              # openssl rand -hex 32
POSTGRES_PASSWORD=           # openssl rand -hex 16
CLICKHOUSE_PASSWORD=         # openssl rand -hex 16
MINIO_ROOT_PASSWORD=         # openssl rand -hex 16
REDIS_AUTH=                  # openssl rand -hex 16
TELEMETRY_ENABLED=false
LANGFUSE_INIT_ORG_ID=you-agent
LANGFUSE_INIT_ORG_NAME=you-agent
LANGFUSE_INIT_PROJECT_ID=you-agent
LANGFUSE_INIT_PROJECT_NAME=you-agent
LANGFUSE_INIT_PROJECT_PUBLIC_KEY=pk-lf-<uuid>
LANGFUSE_INIT_PROJECT_SECRET_KEY=sk-lf-<uuid>
LANGFUSE_INIT_USER_EMAIL=admin@example.com
LANGFUSE_INIT_USER_NAME=admin
LANGFUSE_INIT_USER_PASSWORD=  # choose a password of at least 8 characters

# ---- you.com MCP -----------------------------------------------------------
# Leave empty to use the free profile (you-search + you-discover, 100 q/day).
# Get a key at https://you.com/platform for you-contents / you-research / you-finance.
YDC_API_KEY=
# YDC_ALLOWED_TOOLS=you-search,you-contents,you-research
# YDC_MCP_URL=https://api.you.com/mcp

# ---- Ollama ----------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=gpt-oss:20b        # must support tool calling (gpt-oss, qwen3*, llama3.1+, mistral-nemo…). 27B+ models spill to CPU on 24GB Macs
OLLAMA_NUM_CTX=16384

# ---- Claude via Claude Code CLI (`claude -p`) ---------------------------------
# Runs on your Claude subscription. Requires the `claude` CLI to be installed and logged in.
CLAUDE_CODE_MODEL=opus              # alias (opus | sonnet | fable) or a full model id
CLAUDE_CODE_MAX_TURNS=12
# CLAUDE_CODE_BIN=claude
# CLAUDE_CODE_WORKDIR=~/.cache/you-agent/claude-workdir

# ---- Claude via Anthropic API (optional, needs API credits) --------------------
# Setting ANTHROPIC_API_KEY adds a third model, you-agent-claude-api.
# ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-opus-5-5     # or claude-sonnet-5-5, claude-haiku-5-5
CLAUDE_EFFORT_LEVEL=medium          # low | medium | high | xhigh | max
CLAUDE_MAX_TOKENS=16000

# ---- Base-model switch --------------------------------------------------------
# Default provider for the CLI and for unknown model names: "ollama" | "claude" | "claude-api".
# Open WebUI shows you-agent (Ollama) and you-agent-claude (Claude Code), plus
# you-agent-claude-api when ANTHROPIC_API_KEY is set, so users switch per chat.
MODEL_PROVIDER=ollama

# ---- Agent server (what Open WebUI talks to) --------------------------------
AGENT_NAME=you-agent
AGENT_PORT=8010

# ---- OpenCrawl (self-hosted session capture + team search) -------------------
# Runs inside `docker compose up -d` from the opencrawl-core submodule (UI: http://localhost:8092).
# Clone with `git clone --recurse-submodules` or run `git submodule update --init`.
# Generate every secret below once; the identity/registry DBs refuse to reopen under a different org id.
OPENCRAWL_URL=http://localhost:8092
OPENCRAWL_BOARD=true               # set false to keep handoffs in process only
OPENCRAWL_BIN=opencrawl
OPENCRAWL_ORGANIZATION_ID=org_      # org_$(od -An -tx1 -N24 /dev/urandom | tr -d ' \n')
OPENCRAWL_AUTH_SECRET=              # od -An -tx1 -N24 /dev/urandom | tr -d ' \n'
OPENCRAWL_SETUP_TOKEN=              # same; used once for the first-admin signup link
OPENCRAWL_CONNECTOR_KEY=            # dd if=/dev/urandom bs=32 count=1 | base64
OPENCRAWL_S3_ACCESS_KEY_ID=         # opencrawl<12 hex chars>
OPENCRAWL_S3_SECRET_ACCESS_KEY=     # od -An -tx1 -N24 /dev/urandom | tr -d ' \n'
OPENCRAWL_DATABASE_PASSWORD=        # same
OPENCRAWL_TEMPORAL_PASSWORD=        # same
OPENCRAWL_APP_PORT=8092
OPENCRAWL_S3_PORT=18333
